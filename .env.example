# ====================================================================
# canvas-agent-reader: Environment Configuration Template
# Copy this file to .env to configure your local setup.
# NOTE: .env is in .gitignore and will NEVER be pushed to Git.
# ====================================================================

# Optional: Default Figma Design URL
# If configured, you can run 'canvas-agent-reader figma' without repeating the URL.
FIGMA_URL=https://www.figma.com/design/YOUR_FILE_KEY/YOUR_PROJECT_NAME?node-id=0-1

# Optional: Chrome DevTools Protocol (CDP) remote debugging port
CDP_PORT=9222
